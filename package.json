{
  "name": "voxarrium",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Voxarrium M5: three connected streamed exploration areas in Three.js.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test tests/bootstrap.test.mjs && playwright test --project=simulation",
    "test:browser": "playwright test --project=browser --project=rural-browser --project=living-browser --project=district-browser --project=streaming-browser --project=city-browser --project=urban-browser",
    "capture:m7": "playwright test --project=urban-browser",
    "capture:m6": "playwright test --project=city-browser --grep captures",
    "capture:m5": "playwright test --project=streaming-browser --grep captures",
    "measure:tail": "node tools/measure-tail.mjs",
    "stress:streaming": "node tools/stress-streaming.mjs",
    "capture:m4": "playwright test --project=district-browser --grep evidence",
    "capture:m3": "playwright test --project=living-browser --grep evidence",
    "capture": "playwright test --project=rural-browser --grep evidence",
    "capture:m1": "playwright test --project=browser --grep evidence",
    "check": "node tools/check.mjs && npm run typecheck",
    "doctor": "node tools/doctor.mjs",
    "references:verify": "node tools/references.mjs",
    "blender:fixture": "node tools/blender-fixture.mjs",
    "blender:rural": "node tools/blender-rural.mjs",
    "blender:district": "node tools/blender-district.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
