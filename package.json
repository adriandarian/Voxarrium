{
  "name": "voxarrium",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Voxarrium M2: a playable rural reference art slice in Three.js.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test tests/bootstrap.test.mjs && playwright test --project=simulation",
    "test:browser": "playwright test --project=browser --project=rural-browser",
    "capture": "playwright test --project=rural-browser --grep evidence",
    "capture:m1": "playwright test --project=browser --grep evidence",
    "check": "node tools/check.mjs && npm run typecheck",
    "doctor": "node tools/doctor.mjs",
    "references:verify": "node tools/references.mjs",
    "blender:fixture": "node tools/blender-fixture.mjs",
    "blender:rural": "node tools/blender-rural.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
